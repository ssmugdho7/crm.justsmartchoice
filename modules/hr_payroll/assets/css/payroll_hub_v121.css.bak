
/* Scoped to Payroll Hub only. Never changes CRM core tables. */
.payroll-hub-page, body[class*="hr_payroll"] #wrapper .content { --ph-blue:#1f3c88;--ph-green:#169179;--ph-orange:#f97316;--ph-bg:#f5f7fb; }
body:has(a[href*="admin/hr_payroll"]) #wrapper .content, .payroll-hub-page {background:var(--ph-bg,#f5f7fb)}
.payroll-hub-page .panel_s,.payroll-hub-page .panel-body, body[class*="hr_payroll"] .panel_s{border-radius:14px;box-shadow:0 8px 24px rgba(15,23,42,.08);border:1px solid #e5e7eb}
.payroll-hub-page h4, body[class*="hr_payroll"] h4{color:#1f3c88;font-weight:700}
.ph-hero{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px 20px;margin-bottom:18px;border-radius:14px;background:linear-gradient(135deg,#1f3c88,#169179);color:#fff}.ph-hero h3,.ph-hero p{color:#fff;margin:0}.ph-hero p{opacity:.9;margin-top:5px}.ph-badge{background:#fff;color:#1f3c88;padding:6px 12px;border-radius:999px;font-weight:700}
.ph-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:16px;margin-bottom:16px;box-shadow:0 5px 16px rgba(15,23,42,.05)}.ph-card h4{margin:0 0 14px}
/* Existing spreadsheet screens: contained, narrow, no page-level scrollbars. */
body[class*="hr_payroll"] .hot, .payroll-hub-page .hot{width:100%!important;max-width:100%!important;overflow:hidden!important;border:1px solid #dbe4ef;border-radius:10px;background:#fff}
body[class*="hr_payroll"] .handsontable, .payroll-hub-page .handsontable{width:100%!important;max-width:100%!important;font-size:12px!important}
body[class*="hr_payroll"] .handsontable td,body[class*="hr_payroll"] .handsontable th{white-space:normal!important;word-break:normal!important;line-height:1.25!important;padding:5px 7px!important;height:auto!important;min-width:64px!important}
body[class*="hr_payroll"] .handsontable th{background:#1f3c88!important;color:#fff!important;font-weight:700!important}
body[class*="hr_payroll"] .wtHolder{overflow:auto!important;max-width:100%!important;max-height:65vh!important;scrollbar-width:thin}
body[class*="hr_payroll"] .dataTables_wrapper{width:100%!important;overflow:visible!important}body[class*="hr_payroll"] table.dataTable{width:100%!important;table-layout:fixed!important}body[class*="hr_payroll"] table.dataTable th,body[class*="hr_payroll"] table.dataTable td{white-space:normal!important;overflow-wrap:anywhere!important;vertical-align:middle!important;padding:7px 8px!important;font-size:12px!important}body[class*="hr_payroll"] table.dataTable thead th{background:#1f3c88!important;color:#fff!important}
body[class*="hr_payroll"] .table-responsive{overflow:visible!important}.btn{border-radius:7px}.btn-info,.btn-primary{background:#169179;border-color:#169179}.btn-info:hover,.btn-primary:hover{background:#0e6f5b;border-color:#0e6f5b}
.ph-template-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ph-template-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;box-shadow:0 7px 20px rgba(15,23,42,.08)}.ph-template-thumb{height:180px;padding:12px;background:#eef2f7;cursor:pointer}.ph-template-sheet{height:100%;background:#fff;border:1px solid #cbd5e1;padding:10px;font-size:8px;box-shadow:0 3px 10px rgba(0,0,0,.12)}.ph-template-sheet .bar{height:12px;background:var(--accent,#1f3c88);margin-bottom:8px}.ph-template-sheet .line{height:5px;background:#dbe4ef;margin:5px 0}.ph-template-sheet .totals{margin-top:10px;border-top:2px solid var(--accent,#1f3c88);padding-top:5px}.ph-template-info{padding:12px}.ph-template-info strong{display:block;color:#1f3c88}.ph-template-info small{color:#64748b}
@media(max-width:1100px){.ph-template-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:768px){.ph-template-grid{grid-template-columns:repeat(2,1fr)}.ph-hero{align-items:flex-start;flex-direction:column}body[class*="hr_payroll"] .wtHolder{overflow:auto!important}}@media(max-width:480px){.ph-template-grid{grid-template-columns:1fr}}
