<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Main" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/themeColorPrimary</item>
        <item name="colorPrimaryVariant">@color/themeColorSecondary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/BlueAngel</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/themeColorSecondary</item>
        <item name="android:textColor">@color/Gray</item>
        <item name="android:textColorPrimary">@color/colorGrey</item>
        <!-- Customize your theme here. -->

        <item name="android:windowContentTransitions">true</item>
    </style>


    <style name="SimpleTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.MoneyManager.AppBarOverlay.TabbedTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar" >
        <item name="tabIndicatorColor">@color/white</item>
        <item name="textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.AppCompat.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="LoginTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/white</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>